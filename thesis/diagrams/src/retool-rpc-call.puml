@startuml

!theme sunlust
skinparam dpi 300
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false

autonumber "<b>[0]"

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam participant {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione dei Partecipanti
' =======================================
actor Admin
participant "Retool Dashboard" as Retool
participant "RPC Function\n(es. admin_get_all_accounts)" as RPC
database "PostgreSQL DB" as DB

' =======================================
' Flusso della Chiamata Sicura
' =======================================
Admin -> Retool : Carica la pagina "Gestione Utenti"

Retool -> RPC : Invoca la funzione
activate RPC
RPC -> RPC : Controlla: `session_user = 'retool'`

alt <color:#006400>Security Check: Success</color>
    RPC -> DB : Esegue la query sui dati richiesti
    activate DB
    DB --> RPC : Restituisce i dati
    deactivate DB
    RPC --> Retool : Restituisce i dati (JSON)
else <color:red>Security Check: Failure</color>
    RPC --> Retool : Error: 'Permission Denied'
end

deactivate RPC

@enduml