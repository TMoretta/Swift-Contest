@startuml

!theme sunlust
skinparam dpi 300
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false

autonumber

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam participant {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' skinparam actor {
'     BackgroundColor #LightSkyBlue
' }
' skinparam participant {
'     BackgroundColor #E6F3FF
' }
' skinparam database {
'     BackgroundColor #E6F3FF
' }

' =======================================
' Definizione dei Partecipanti
' =======================================
actor Admin
participant "Retool Dashboard" as Retool
database "PostgreSQL DB" as DB
participant "RPC Function\n(es. admin_get_all_accounts)" as RPC

' =======================================
' Flusso della Chiamata Sicura
' =======================================
Admin -> Retool : Carica la pagina "Gestione Utenti"

Retool -> DB : Esegue query:\n`SELECT * FROM ...`\n(autenticato come 'retool_user')

DB -> RPC : Invoca la funzione

group Validazione Sicurezza
    RPC -> RPC : Controlla: `session_user = 'retool_user'`
    alt Utente non autorizzato
        RPC --> DB : Solleva un'eccezione\n'Permission denied'
        DB --> Retool : Restituisce Errore
        destroy RPC
    end
end

' Se l'utente è autorizzato, procede
RPC -> DB : Esegue la query di SELECT\nsui dati richiesti
DB --> RPC : Restituisce i risultati

RPC --> DB : Inoltra i risultati
DB --> Retool : Restituisce i dati (JSON)

@enduml