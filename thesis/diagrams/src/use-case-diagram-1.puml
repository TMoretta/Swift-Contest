@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam usecase {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Attori
' =======================================
actor Guest
actor Authenticated
actor Organizer
actor Participant
actor Juror

Authenticated <|-- Organizer
Authenticated <|-- Participant
Authenticated <|-- Juror

' =======================================
' Packages e Casi d'Uso
' =======================================

package "General Management" {
  usecase "Download application" as UC_DownloadApplication
}

package "Authentication & Account Management" {
  usecase "Sign up" as UC_SignUp
  usecase "Sign in" as UC_SignIn
  usecase "Sign out" as UC_SignOut
  usecase "Edit profile" as UC_EditProfile
  usecase "Delete own account" as UC_DeleteAccount
  usecase "Manage notifications" as UC_ManageNotifications
}

' =======================================
' Connessioni
' =======================================

' Guest
Guest --> UC_SignUp
Guest --> UC_SignIn
Guest --> UC_DownloadApplication

' Authenticated
Authenticated --> UC_SignOut
Authenticated --> UC_EditProfile
Authenticated --> UC_DeleteAccount
Authenticated --> UC_ManageNotifications

@enduml