@startuml

!theme sunlust
skinparam dpi 300
top to bottom direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam ranksep 25
'skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam rectangle {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione dei Componenti
' =======================================

package "Architettura Client Flutter (MVVM/BLoC)" {

    rectangle "**View**\n(Widget UI)" as View
    rectangle "**ViewModel**\n(BLoC)" as BLoC
    rectangle "**Model**\n(Repository)" as Repository

    database "Backend\n(API Supabase)" as Backend
}

' =======================================
' Definizione del Flusso di Dati
' =======================================

' --- Flusso di Interazione dell'Utente (Comando) ---
View -> BLoC : 1. Notifica un **Evento**\n (es. pressione di un pulsante)
BLoC -> Repository : 2. Invoca un metodo\n (es. fetchData())
Repository -> Backend : 3. Esegue la chiamata API
Backend --> Repository : 4. Restituisce i dati (JSON)

' --- Flusso di Ritorno dei Dati (Elaborazione) ---
Repository --> BLoC : 5. Restituisce il risultato\n (es. Either<Failure, Data>)

' --- Flusso Reattivo dello Stato (Stream di Stati) ---
' Il BLoC elabora il risultato ed emette un nuovo stato
BLoC --> View : 6. Emette un nuovo **Stato**
note on link
  Il BLoC elabora la logica
  ed emette un nuovo Stato
end note

' La View si ricostruisce in base al nuovo stato
View -> View : 7. Ricostruisce la UI in base allo Stato
note on link
  (es. tramite BlocBuilder)
end note

@enduml