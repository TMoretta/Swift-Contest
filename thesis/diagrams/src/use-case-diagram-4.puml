@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam usecase {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Attori
' =======================================
actor Amministratore

' =======================================
' Packages e Casi d'Uso
' =======================================

package "Amministrazione" {
  usecase "Gestisci contest" as UC_AdminManageContests
  usecase "Gestisci utenti" as UC_AdminManageUsers
}

' =======================================
' Connessioni
' =======================================

Amministratore --> UC_AdminManageUsers
Amministratore --> UC_AdminManageContests

@enduml