@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 25

' --- Palette di Colori ---
skinparam node {
    backgroundColor #FFFFFF
    borderColor #555555
}

' =======================================
' Definizione dei Nodi e degli Artefatti
' =======================================

' --- Attori ---
actor Utente
actor Amministratore

' --- Nodo Client ---
node "Dispositivo dell'Utente" as UserDevice {
    artifact "App Flutter" as App
}

' --- Piattaforme Cloud ---
node "Piattaforma Supabase" as SupabaseNode {
    database "DB PostgreSQL" as DB

    component [API RPC] as RPC
    component [Servizio Storage] as Store
    component [Servizio Realtime] as RT
    component [Servizio Autenticazione] as Auth

    node "Runtime Edge Functions" as EdgeRuntime <<executionEnvironment>>

    artifact "Migrazioni SQL" as SQLScripts
    artifact "Codice Edge Functions" as EFCode
}

node "Piattaforma Vercel" as VercelNode {
    artifact "Build Web Statica" as WebApp
}

node "Piattaforma GitHub" as GitHubNode {
    artifact "APK Android" as APK
}

node "Piattaforma Retool" as RetoolNode {
    artifact "Dashboard Admin" as RetoolApp
}

' --- Servizi Esterni ---
node "Piattaforma Google Cloud" as GoogleNode {
    component [API Google Places] as GooglePlaces
}

node "Piattaforma Resend" as ResendNode {
    component [API Resend] as Resend
}


' =======================================
' Definizione delle Relazioni
' =======================================

' --- Flussi di Comunicazione ---
Utente --> App : Interagisce con
Amministratore --> RetoolApp : Gestisce il sistema

' Il client carica l'app da Vercel
App <.. WebApp : Carica

' Comunicazioni dell'App Flutter
App --> Auth : Autentica (HTTPS)
App --> RPC : Invoca RPC (HTTPS)
App --> Store : Carica/Scarica File (HTTPS)
App --> EdgeRuntime : Invoca Funzioni (HTTPS)
App --> RT : Si sottoscrive (WSS)

' Comunicazioni interne a Supabase
RPC --> DB
EdgeRuntime --> DB : Accede ai Dati

' Comunicazioni delle Edge Functions verso l'esterno
EdgeRuntime --> Resend : Invia Email (HTTPS)
EdgeRuntime --> GooglePlaces : Funge da Proxy per API (HTTPS)
EdgeRuntime --> GitHubNode : Recupera APK (HTTPS)

' Comunicazioni della Dashboard Admin
RetoolApp --> RPC : Invoca RPC Admin (HTTPS)
RetoolApp --> EdgeRuntime : Invoca Funzioni Admin (HTTPS)

' --- NUOVA SEZIONE: Relazioni di Deployment ---
' Mostra quali artefatti sono distribuiti su quali componenti
SQLScripts ..> DB : <<deploy>>
EFCode ..> EdgeRuntime : <<deploy>>

@enduml