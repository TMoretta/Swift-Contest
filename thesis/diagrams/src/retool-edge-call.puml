@startuml

!theme sunlust
skinparam dpi 300
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false

autonumber "<b>[0]"

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam participant {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione dei Partecipanti
' =======================================
actor Amministratore as Admin
participant "Retool Dashboard" as Retool
participant "Edge Function\n(es. admin-delete-account)" as Edge
' MODIFICA: Sostituito con partecipanti specifici
database "PostgreSQL DB" as DB
participant "Storage API" as Storage

' =======================================
' Flusso della Chiamata Sicura
' =======================================
Admin -> Retool : Clicca su "Elimina Utente"

Retool -> Edge : Invia richiesta POST\n(include header 'X-API-Key')
activate Edge

' MODIFICA: Il controllo della chiave API è un'azione interna
Edge -> Edge : Controllo di Sicurezza:\n- Legge 'RETOOL_API_KEY' dai segreti\n- Confronta con la chiave ricevuta

alt <color:#006400>Chiave API Valida</color>
    ' MODIFICA: La funzione ora chiama servizi specifici

      Edge -> DB : Elimina i record dell'utente
      activate DB
      DB --> Edge : Conferma eliminazione
      deactivate DB

      Edge -> Storage : Elimina i file dell'utente
      activate Storage
      Storage --> Edge : Conferma eliminazione
      deactivate Storage

    Edge --> Retool : Restituisce Risposta 200 (OK)

else <color:red>Chiave API Invalida</color>
    Edge --> Retool : Error: 401 (Unauthorized)
end

deactivate Edge

@enduml