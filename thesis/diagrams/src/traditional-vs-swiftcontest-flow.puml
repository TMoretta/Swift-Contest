@startuml

!theme sunlust
top to bottom direction
skinparam dpi 300
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam rectangle {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' --- Palette di Colori ---
' skinparam package {
    
' }
