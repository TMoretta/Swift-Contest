@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 20

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam rectangle {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione dei Diagrammi
' =======================================

' --- Processo Tradizionale ---
package "Processo Tradizionale (Frammentato)" as Traditional {
    actor Organizzatore as Org_T
    actor Partecipante as Part_T
    actor Giurato as Jur_T

    rectangle "Email" as Email
    rectangle "Archivio Cloud" as Storage
    rectangle "Moduli Online" as Forms
    rectangle "Fogli di Calcolo" as Sheet

    ' Flusso di dati frammentato
    Org_T --> Email : Invia inviti
    Email ..> Part_T : (Riceve invito)
    Email ..> Jur_T : (Riceve invito)

    Part_T --> Storage : Carica lavoro
    Jur_T --> Forms : Inserisce voti
    Forms ..> Sheet : (Esportazione dati)

    ' Lavoro manuale dell'organizzatore per collegare tutto
    Org_T .[#red].> Email : (Controlla\niscrizioni)
    Org_T .[#red].> Storage : (Associa lavori\nai partecipanti)
    Org_T .[#red].> Sheet : (Analizza e\nconsolida risultati)
}

' --- Processo Swift Contest ---
package "Processo Integrato (Swift Contest)" as SwiftContest {
    actor Giurato as Jur_S
    actor Partecipante as Part_S
    actor Organizzatore as Org_S

    package "**Piattaforma Swift Contest**" as App {
        rectangle "Gestione Risultati" as Results
        rectangle "Gestione Votazioni" as Votes
        rectangle "Gestione Lavori" as Works
        rectangle "Gestione Membri\ne Inviti" as Users
        database "Unica Fonte di Verità" as SSoT
    }

    ' Tutti gli attori interagiscono con un'unica piattaforma
    Jur_S --> App
    Part_S --> App
    Org_S --> App

    ' Tutti i moduli sono integrati e condividono gli stessi dati
    Users -- SSoT
    Works -- SSoT
    Votes -- SSoT
    Results -- SSoT
}

' --- Layout Hint ---
Traditional -[hidden]- SwiftContest

@enduml