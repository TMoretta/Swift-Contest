@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam rectangle {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione dei Componenti Logici
' =======================================

' --- Il Client ---
actor Utente
rectangle "**Client Flutter**\n(Web & Android)" as Client

' --- Il Server (rappresentato come un Backend BaaS) ---
package "Backend (Supabase BaaS)" {
  rectangle "Autenticazione" as Auth
  database "Database\n(PostgreSQL)" as DB
  rectangle "Storage" as Store
  rectangle "Edge Functions" as Edge
  rectangle "Realtime" as RT
  rectangle "API RPC" as RPC
}

' --- Servizi Esterni ---
package "Servizi Esterni" {
  rectangle "API Resend" as Resend
  rectangle "API Google Places" as GooglePlaces
  rectangle "API GitHub" as GitHub
}


' =======================================
' Definizione delle Interazioni
' =======================================

Utente --> Client : Interagisce con

' --- Interazioni Client -> Backend ---
Client --> Auth : Autentica (HTTPS)
Client --> RPC : Invoca procedure (HTTPS)
Client --> Store : Carica/Scarica file\n(tramite signed URL, HTTPS)
Client --> Edge : Avvia operazioni complesse (HTTPS)
Client --> RT : Si sottoscrive a eventi live (WSS)

' --- Interazioni interne a Supabase ---
' Mostra come i servizi Supabase interagiscono con il DB
Auth --> DB : Gestisce gli utenti
RPC --> DB : Esegue query
Store --> DB : Memorizza metadati
Edge --> DB : Accede ai dati
RT ..> DB : Ascolta le modifiche

' --- Interazioni Backend -> Servizi Esterni ---
' Solo le Edge Functions comunicano con l'esterno
Edge --> Resend : Invia email (HTTPS)
Edge --> GooglePlaces : Funge da proxy per le chiamate API (HTTPS)
Edge --> GitHub : Recupera l'APK (HTTPS)

' --- Evidenziare la sicurezza ---
' Questa linea tratteggiata e rossa mostra che l'accesso diretto è bloccato
Client -[#red,dashed]-> DB
note on link: **Accesso Diretto Negato**\n(Principio del Minimo Privilegio)

@enduml