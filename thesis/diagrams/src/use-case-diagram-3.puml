@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam usecase {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Attori
' =======================================
actor Ospite
actor Autenticato
actor Giurato
actor Partecipante
actor Organizzatore

Autenticato <|-- Giurato
Autenticato <|-- Organizzatore
Autenticato <|-- Partecipante

' =======================================
' Packages e Casi d'Uso
' =======================================

package "Gestione Votazioni e Classifiche" {
  usecase "Vota in una sessione" as UC_VoteInSession

  usecase "Avvia sessione di voto" as UC_StartVotingSession
  usecase "Annulla sessione di voto" as UC_CancelVotingSession
  usecase "Termina sessione di voto" as UC_EndVotingSession
  usecase "Applica restrizione geografica" as UC_ApplyGeoRestriction

  usecase "Modifica form di voto" as UC_EditJuryForm

  usecase "Genera classifica" as UC_GenerateRanking
  usecase "Pubblica classifica" as UC_PublishRanking
  usecase "Ritira classifica" as UC_UnpublishRanking
  usecase "Scarica classifica" as UC_DownloadRanking

  usecase "Esporta risultati\ndella votazione" as UC_ExportVotingResults
}

' =======================================
' Connessioni
' =======================================

' Ospite (come Giurato Semplice)
Ospite --> UC_VoteInSession : {come Giurato Semplice}

' Giurato (sia Nominato che Semplice)
Giurato --> UC_VoteInSession
Giurato --> UC_DownloadRanking

' Organizzatore
Organizzatore --> UC_EditJuryForm
Organizzatore --> UC_StartVotingSession
Organizzatore --> UC_CancelVotingSession
Organizzatore --> UC_EndVotingSession
Organizzatore --> UC_GenerateRanking
Organizzatore --> UC_PublishRanking
Organizzatore --> UC_UnpublishRanking
Organizzatore --> UC_DownloadRanking
Organizzatore --> UC_ExportVotingResults

' Partecipante
Partecipante --> UC_DownloadRanking

' =======================================
' Relazioni tra Casi d'Uso
' =======================================
(UC_StartVotingSession) .> (UC_ApplyGeoRestriction) : <<extend>>

@enduml