@startuml

!theme sunlust
skinparam dpi 300
left to right direction
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 25

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam usecase {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Attori (Gerarchia Completa)
' =======================================
actor Guest
actor Authenticated
actor Juror
actor Participant
actor Organizer

Authenticated <|-- Juror
Authenticated <|-- Organizer
Authenticated <|-- Participant

' =======================================
' Packages e Casi d'Uso
' =======================================

package "Voting & Ranking Management" {
  usecase "Vote in Session" as UC_VoteInSession

  usecase "Start voting session" as UC_StartVotingSession
  usecase "Cancel voting session" as UC_CancelVotingSession
  usecase "End voting session" as UC_EndVotingSession
  usecase "Apply Geo-Restriction" as UC_ApplyGeoRestriction

  usecase "Edit voting form" as UC_EditJuryForm

  usecase "Generate ranking" as UC_GenerateRanking
  usecase "Publish ranking" as UC_PublishRanking
  usecase "Unpublish ranking" as UC_UnpublishRanking
  usecase "Download ranking" as UC_DownloadRanking

  usecase "Export voting results" as UC_ExportVotingResults
}

' =======================================
' Connessioni
' =======================================

' Guest (come Giurato Semplice)
Guest --> UC_VoteInSession : {as Simple Juror}

' Juror (sia Nominato che Semplice)
Juror --> UC_VoteInSession
Juror --> UC_DownloadRanking

' Organizer
Organizer --> UC_EditJuryForm
Organizer --> UC_StartVotingSession
Organizer --> UC_CancelVotingSession
Organizer --> UC_EndVotingSession
Organizer --> UC_GenerateRanking
Organizer --> UC_PublishRanking
Organizer --> UC_UnpublishRanking
Organizer --> UC_DownloadRanking
Organizer --> UC_ExportVotingResults

Participant --> UC_DownloadRanking

' =======================================
' Relazioni tra Casi d'Uso
' =======================================
(UC_StartVotingSession) .> (UC_ApplyGeoRestriction) : <<extend>>

@enduml