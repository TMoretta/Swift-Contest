\PYG{+w}{    }\PYG{c+c1}{// Estratto da una Edge Function come \PYGZsq{}admin\PYGZhy{}delete\PYGZhy{}account/index.ts\PYGZsq{}}

\PYG{+w}{	}\PYG{c+c1}{// ... (all\PYGZsq{}interno della funzione Deno.serve)}
\PYG{+w}{	}\PYG{k}{try}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{		}\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 1. API KEY AUTHORIZATION \PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{+w}{		}\PYG{c+c1}{// Questo pattern è usato per tutte le chiamate server\PYGZhy{}to\PYGZhy{}server da Retool.}

\PYG{+w}{		}\PYG{c+c1}{// Legge la chiave API inviata dal client (Retool) nell\PYGZsq{}header.}
\PYG{+w}{		}\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{apiKey}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{req}\PYG{p}{.}\PYG{n+nx}{headers}\PYG{p}{.}\PYG{n+nx}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}X\PYGZhy{}API\PYGZhy{}Key\PYGZsq{}}\PYG{p}{);}

\PYG{+w}{		}\PYG{c+c1}{// Recupera la chiave segreta memorizzata in modo sicuro nel Vault di Supabase.}
\PYG{+w}{		}\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{secretKey}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{Deno}\PYG{p}{.}\PYG{n+nx}{env}\PYG{p}{.}\PYG{n+nx}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}RETOOL\PYGZus{}API\PYGZus{}KEY\PYGZsq{}}\PYG{p}{);}

\PYG{+w}{		}\PYG{c+c1}{// Primo controllo: verifica che il segreto sia stato configurato.}
\PYG{+w}{		}\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{o}{!}\PYG{n+nx}{secretKey}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{k}{throw}\PYG{+w}{ }\PYG{o+ow}{new}\PYG{+w}{ }\PYG{n+ne}{Error}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}RETOOL\PYGZus{}API\PYGZus{}KEY is not set in Supabase secrets.\PYGZdq{}}\PYG{p}{);}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}

\PYG{+w}{		}\PYG{c+c1}{// Secondo controllo: confronta la chiave ricevuta con il segreto.}
\PYG{+w}{		}\PYG{c+c1}{// Se non corrispondono, la richiesta viene immediatamente respinta.}
\PYG{+w}{		}\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{apiKey}\PYG{+w}{ }\PYG{o}{!==}\PYG{+w}{ }\PYG{n+nx}{secretKey}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{k}{return}\PYG{+w}{ }\PYG{o+ow}{new}\PYG{+w}{ }\PYG{n+nx}{Response}\PYG{p}{(}
\PYG{+w}{			}\PYG{n+nb}{JSON}\PYG{p}{.}\PYG{n+nx}{stringify}\PYG{p}{(\PYGZob{}}\PYG{+w}{ }\PYG{n+nx}{error}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}Unauthorized. Invalid API Key.\PYGZdq{}}\PYG{+w}{ }\PYG{p}{\PYGZcb{}),}
\PYG{+w}{			}\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{n+nx}{headers}\PYG{o}{:}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{+w}{ }\PYG{p}{...}\PYG{n+nx}{corsHeaders}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}Content\PYGZhy{}Type\PYGZdq{}}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}application/json\PYGZdq{}}\PYG{+w}{ }\PYG{p}{\PYGZcb{},}
\PYG{+w}{				}\PYG{n+nx}{status}\PYG{o}{:}\PYG{+w}{ }\PYG{k+kt}{401}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// 401 Unauthorized}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}
\PYG{+w}{			}\PYG{p}{);}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}

\PYG{+w}{		}\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{} 2. PROSECUZIONE DELLA LOGICA \PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{+w}{		}\PYG{c+c1}{// Se la validazione ha successo, la funzione procede con}
\PYG{+w}{		}\PYG{c+c1}{// l\PYGZsq{}esecuzione delle operazioni amministrative.}

\PYG{+w}{		}\PYG{c+c1}{// ... (logica per eliminare l\PYGZsq{}utente, i file, ecc.)}

