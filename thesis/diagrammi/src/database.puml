@startuml

!theme sunlust
left to right direction
skinparam dpi 300
skinparam backgroundColor transparent
skinparam actorStyle awesome
skinparam shadowing false
skinparam linetype ortho

skinparam package {
    backgroundColor #FFFFFF
    borderColor #555555
}
skinparam class {
  backgroundColor #E6F3FF
  borderColor #3995D7
}

' =======================================
' Definizione delle Entità (Tabelle)
' =======================================

' --- Package: Core Entities ---
package "Core" {
    entity "profiles" as Profiles {
      + id [PK, FK to auth.users]
      --
      full_name: varchar
      pref_role: ContestRole
    }
    entity "contests" as Contests {
      + id [PK]
      --
      organizer_id [FK]
      place_id [FK, UNIQUE]
      name: varchar
      ...
    }
    entity "places" as Places {
      + id [PK]
      --
      address: varchar
      lat: float
      lon: float
    }
    entity "messages" as Messages {
        + id [PK]
        --
        account_id [FK]
        title: varchar
    }
}

' --- Package: Membership & Invitations ---
package "Membership & Invitations" {
    entity "participations" as Participations {
      + id [PK]
      --
      contest_id [FK]
      participant_id [FK]
      has_submitted: bool
    }
    entity "juries" as Juries {
      + id [PK]
      --
      contest_id [FK]
      voting_form_id [FK, UNIQUE]
      name: varchar
      type: JuryType
    }
    entity "jurations" as Jurations {
      + id [PK]
      --
      contest_id [FK]
      jury_id [FK]
      juror_id [FK]
    }
    entity "participant_invitations" as ParticipantInvitations {
        + id [PK]
        --
        contest_id [FK]
        token: varchar [UNIQUE]
    }
    entity "juror_invitations" as JurorInvitations {
        + id [PK]
        --
        jury_id [FK]
        token: varchar [UNIQUE]
    }
}

' --- Package: Works ---
package "Works" {
    entity "works" as Works {
      + id [PK]
      --
      participation_id [FK, UNIQUE]
      name: varchar
      file_path: text
      ...
    }
}

' --- Package: Voting ---
package "Voting" {
    ' Voting Forms
    entity "voting_forms" as VotingForms {
      + id [PK]
      --
      name: varchar
    }
    entity "voting_form_fields" as VotingFormFields {
      + id [PK]
      --
      voting_form_id [FK]
      question: varchar
      type: VotingFormFieldType
      scope: VotingFormFieldScope
    }

    ' Voting Process
    entity "voting_sessions" as VotingSessions {
      + id [PK]
      --
      contest_id [FK]
      geo_res_place_id [FK, UNIQUE]
      status: VotingSessionStatus
    }
    entity "voting_form_submissions" as Submissions {
      + id [PK]
      --
      voting_session_id [FK]
      voting_session_juror_id [FK, UNIQUE]
    }
    entity "voting_form_submission_values" as SubmissionValues {
      + id [PK]
      --
      voting_form_submission_id [FK]
      voting_form_field_id [FK]
      voting_session_participant_id [FK]
      value: text
    }

    ' Snapshot Tables
    entity "voting_session_juries" as VSJuries {
        + id [PK]
        --
        voting_session_id [FK]
        jury_id [FK]
        == Snapshot Data
        jury_name: varchar
        jury_type: JuryType
    }
    entity "voting_session_jurors" as VSJurors {
      + id [PK]
      --
      voting_session_id [FK]
      voting_session_jury_id [FK]
      juration_id [FK]
      juror_id [FK]
      == Snapshot Data
      juror_full_name: varchar
    }
    entity "voting_session_participants" as VSParticipants {
      + id [PK]
      --
      voting_session_id [FK]
      participation_id [FK]
      == Snapshot Data
      participant_full_name: varchar
      work_name: varchar
      ...
    }
    entity "voting_session_exclusions" as VSExclusions {
        + id [PK]
        --
        voting_session_id [FK]
        voting_session_juror_id [FK]
        voting_session_participant_id [FK]
    }
}

' --- Package: Results ---
package "Results" {
    entity "contest_rankings" as Rankings {
        + id [PK]
        --
        contest_id [FK]
        file_path: text [UNIQUE]
    }
}


' =======================================
' Definizione delle Relazioni (CON NOTAZIONE GRAFICA CORRETTA)
' =======================================

' --- Core Relationships ---
Profiles ||--o{ Messages
Profiles ||--o{ Contests
Contests ||--|| Places

' --- Membership & Invitations ---
Contests ||--|{ Participations
Profiles ||--o{ Participations
Contests ||--o{ ParticipantInvitations

Contests ||--o{ Juries
Juries ||--o{ Jurations
Profiles ||--o{ Jurations
Juries ||--o{ JurorInvitations

' --- Works ---
Participations ||--|| Works

' --- Voting Forms (now inside Voting) ---
Juries ||--|| VotingForms
VotingForms ||--|{ VotingFormFields

' --- Voting Process ---
Contests ||--o{ VotingSessions
VotingSessions ||--o| Places
VotingSessions ||--o{ Submissions
VSJurors ||--|| Submissions
Submissions ||--|{ SubmissionValues
VotingFormFields ||--o{ SubmissionValues

' --- Snapshot Relationships ---
VotingSessions ||--|{ VSJuries
VotingSessions ||--o{ VSJurors
VotingSessions ||--|{ VSParticipants
VSJuries ||--o{ VSJurors

' Dotted lines for optional/SET NULL relationships
Juries ..> VSJuries
Jurations ..> VSJurors
Profiles ..> VSJurors
Participations ..> VSParticipants
VSParticipants ..> SubmissionValues

' --- Exclusions ---
VSJurors ||--o{ VSExclusions
VSParticipants ||--o{ VSExclusions

' --- Rankings ---
Contests ||--o{ Rankings

@enduml