% =======================================
% PRINCIPI E PATTERN ARCHITETTURALI
% =======================================

\newglossaryentry{ssot}{
    name={SSoT (Single Source of Truth)},
    description={Un principio di progettazione dei sistemi informativi secondo cui ogni elemento informativo deve avere un'unica fonte di origine autorevole. Questo approccio elimina la duplicazione e la desincronizzazione dei dati, garantendo che tutti i componenti del sistema facciano riferimento alla medesima versione della verità}
}

\newglossaryentry{soc}{
    name={SoC (Separation of Concerns)},
    description={Un principio di progettazione che promuove la suddivisione di un sistema software in parti distinte, ciascuna responsabile di una specifica funzionalità o ambito logico. Tale separazione migliora la modularità, la manutenibilità e la testabilità del codice}
}

\newglossaryentry{polp}{
    name={PoLP (Principle of Least Privilege)},
    description={Un principio fondamentale della sicurezza informatica che stabilisce che a un utente, processo o programma debbano essere concessi esclusivamente i privilegi minimi indispensabili per svolgere le proprie funzioni, riducendo così la superficie di attacco}
}

\newglossaryentry{mvvm_pattern}{
    name={MVVM (Model-View-ViewModel)},
    description={Un pattern architetturale per la progettazione di interfacce utente che separa nettamente la logica di presentazione (ViewModel) dalla UI (View). La View osserva i dati esposti dal ViewModel e reagisce automaticamente ai cambiamenti di stato senza manipolare direttamente i dati}
}

\newglossaryentry{bloc_pattern}{
    name={BLoC (Business Logic Component)},
    description={Un design pattern per la gestione dello stato, diffuso nell'ecosistema Flutter, che separa la logica di business dalla presentazione utilizzando flussi di dati (Streams). I componenti UI emettono eventi e il BLoC risponde emettendo nuovi stati}
}

\newglossaryentry{repository_pattern}{
    name={Repository Pattern},
    description={Un design pattern strutturale che media tra il livello di dominio e i livelli di mappatura dei dati. Agisce come una collezione in memoria di oggetti di dominio, astraendo le complessità dell'accesso al database o alle API esterne}
}

\newglossaryentry{singleton_pattern}{
    name={Singleton Pattern},
    description={Un design pattern creazionale che garantisce l'esistenza di un'unica istanza di una classe all'interno dell'intero ciclo di vita dell'applicazione, fornendo un punto di accesso globale ad essa}
}

\newglossaryentry{hard_soft_delete}{
    name={Hard Delete vs Soft Delete},
    description={Strategie contrapposte per la rimozione dei dati. L'Hard Delete comporta la rimozione fisica e definitiva del record dal database. Il Soft Delete mantiene il record, marcandolo come "cancellato" tramite un apposito flag, permettendo così il recupero o l'audit dei dati storici}
}

\newglossaryentry{rls_principle}{
    name={RLS (Row Level Security)},
    description={Una funzionalità di sicurezza integrata in alcuni DBMS (come PostgreSQL) che consente di definire policy granulari per controllare l'accesso alle singole righe di una tabella in base all'identità o ai ruoli dell'utente che esegue la query}
}

\newglossaryentry{security_definer}{
    name={SECURITY DEFINER},
    description={Una specifica per le funzioni in PostgreSQL che determina il contesto di esecuzione. Una funzione definita con questa clausola viene eseguita con i privilegi dell'utente che l'ha creata (il proprietario), ignorando i permessi dell'utente che la invoca, utile per operazioni privilegiate controllate}
}

% =======================================
% CONCETTI E TECNOLOGIE SOFTWARE
% =======================================

\newglossaryentry{api}{
    name={API (Application Programming Interface)},
    description={Un insieme di definizioni, protocolli e strumenti che permette a diverse applicazioni software di comunicare tra loro, astraendo l'implementazione sottostante e esponendo solo le funzionalità necessarie all'interazione}
}

\newglossaryentry{baas}{
    name={BaaS (Backend-as-a-Service)},
    description={Un modello di servizio cloud che fornisce agli sviluppatori un'infrastruttura backend pre-configurata e gestita, includendo funzionalità come database, autenticazione, notifiche e storage, accessibili tramite API}
}

\newglossaryentry{cicd}{
    name={CI/CD (Continuous Integration/Continuous Deployment)},
    description={Un insieme di pratiche DevOps che mira ad automatizzare le fasi di integrazione del codice, testing e rilascio in produzione, permettendo iterazioni frequenti e affidabili del software}
}

\newglossaryentry{crossplatform}{
    name={Cross-Platform},
    description={Metodologia di sviluppo che consente la creazione di software compatibile con molteplici sistemi operativi (es. iOS, Android, Web) partendo da un'unica base di codice (codebase)}
}

\newglossaryentry{edgefunctions}{
    name={Edge Function},
    description={Funzioni serverless eseguite in nodi di rete distribuiti geograficamente (edge locations) il più vicino possibile all'utente finale, al fine di minimizzare la latenza di elaborazione e risposta}
}

\newglossaryentry{rpc}{
    name={RPC (Remote Procedure Call)},
    description={Un protocollo che permette a un programma di richiedere l'esecuzione di una procedura (subroutine) su un computer remoto come se fosse una chiamata locale. Nei database moderni, indica spesso l'esposizione di stored procedures tramite API}
}

\newglossaryentry{iac}{
    name={IaC (Infrastructure as Code)},
    description={La pratica di gestire e configurare l'infrastruttura informatica attraverso file di definizione leggibili dalla macchina e versionabili, piuttosto che mediante configurazione manuale dell'hardware o interfacce grafiche}
}

\newglossaryentry{jwt}{
    name={JWT (JSON Web Token)},
    description={Uno standard aperto (RFC 7519) che definisce un metodo compatto e autonomo per trasmettere informazioni in modo sicuro tra le parti come oggetto JSON. È ampiamente utilizzato per l'autenticazione stateless e lo scambio di informazioni}
}

\newglossaryentry{spa}{
    name={SPA (Single Page Application)},
    description={Un'applicazione web che interagisce con l'utente riscrivendo dinamicamente la pagina corrente anziché caricare intere nuove pagine dal server, offrendo un'esperienza utente fluida simile a quella delle applicazioni desktop}
}

\newglossaryentry{pat}{
    name={PAT (Personal Access Token)},
    description={Un token di sicurezza utilizzato come alternativa alle password per l'autenticazione in sistemi e API. Permette spesso un controllo più granulare dei permessi (scope) e la possibilità di revoca indipendente dalle credenziali principali}
}

\newglossaryentry{snapshot}{
    name={Snapshot (dei dati)},
    description={Tecnica che consiste nel catturare e registrare lo stato statico di un set di dati in un preciso istante temporale. Viene utilizzata per storicizzare informazioni che non devono subire mutazioni retroattive}
}

\newglossaryentry{denormalization}{
    name={Denormalizzazione},
    description={Tecnica di ottimizzazione dei database relazionali che prevede l'aggiunta deliberata di ridondanza ai dati per migliorare le prestazioni in lettura, riducendo la necessità di operazioni di join costose}
}

\newglossaryentry{token}{
    name={Token},
    description={In ambito informatico, una stringa di dati che funge da identificatore univoco o credenziale di accesso, utilizzata per autorizzare operazioni, gestire sessioni o identificare risorse senza esporre dati sensibili}
}

\newglossaryentry{either_type}{
    name={Either (Tipo di Dato)},
    description={Un costrutto della programmazione funzionale che rappresenta un valore che può assumere uno di due tipi possibili (generalmente denominati Left e Right). È comunemente usato per la gestione degli errori, dove Left contiene l'errore e Right il valore di successo}
}

\newglossaryentry{equatable}{
    name={Equatable},
    description={Nel contesto Dart/Flutter, una libreria che semplifica l'implementazione dell'uguaglianza strutturale tra oggetti, permettendo di confrontare istanze basandosi sul valore delle loro proprietà anziché sul riferimento in memoria}
}

\newglossaryentry{db_trigger}{
    name={Trigger (di Database)},
    description={Un blocco di codice procedurale memorizzato nel database che viene eseguito automaticamente (attivato) in risposta a specifici eventi su una tabella, come inserimenti, aggiornamenti o cancellazioni}
}

\newglossaryentry{signed_url}{
    name={Signed URL},
    description={Un indirizzo web che include parametri di autenticazione (una firma crittografica) nella query string, garantendo l'accesso temporaneo e sicuro a una risorsa specifica senza richiedere ulteriori credenziali all'utente}
}

\newglossaryentry{anonymous_auth}{
    name={Autenticazione Anonima},
    description={Un metodo di autenticazione che permette di creare sessioni utente temporanee senza richiedere credenziali identificative (email/password), consentendo l'accesso limitato e la successiva eventuale conversione in account permanente}
}

\newglossaryentry{stream}{
    name={Stream},
    description={In programmazione reattiva, una sequenza di dati asincroni che possono essere osservati nel tempo. Permette di gestire eventi, dati o errori man mano che vengono prodotti, senza bloccare l'esecuzione del programma}
}

\newglossaryentry{dart_extension}{
    name={Dart Extension},
    description={Una funzionalità del linguaggio Dart che consente di aggiungere nuove funzionalità (metodi, getter, setter) a librerie o classi esistenti senza doverle ereditare o modificare direttamente il codice sorgente}
}

\newglossaryentry{deeplinking}{
    name={Deep Linking},
    description={La pratica di utilizzare un URI (Uniform Resource Identifier) specifico per indirizzare un utente a un contenuto o una sezione precisa all'interno di un'applicazione mobile o web, bypassando la schermata principale}
}

\newglossaryentry{lowcode}{
    name={Low-code},
    description={Approccio allo sviluppo software che minimizza la codifica manuale attraverso l'uso di interfacce visuali e componenti pre-configurati, accelerando la creazione di applicazioni business e strumenti interni}
}

\newglossaryentry{hotreload}{
    name={Hot Reload},
    description={Funzionalità degli ambienti di sviluppo moderni che inietta le versioni aggiornate dei file di codice sorgente nella Virtual Machine (VM) in esecuzione, permettendo di visualizzare le modifiche quasi istantaneamente senza perdere lo stato dell'applicazione}
}

\newglossaryentry{jit}{
    name={JIT (Just-In-Time Compilation)},
    description={Tecnica di compilazione in cui il codice viene tradotto in linguaggio macchina durante l'esecuzione del programma, anziché prima. Favorisce cicli di sviluppo rapidi e funzionalità dinamiche}
}

\newglossaryentry{aot}{
    name={AOT (Ahead-Of-Time Compilation)},
    description={Tecnica di compilazione in cui il codice viene tradotto in linguaggio macchina nativo prima dell'esecuzione. Questo approccio ottimizza le prestazioni a runtime e riduce i tempi di avvio dell'applicazione}
}

\newglossaryentry{dsl}{
    name={DSL (Domain-Specific Language)},
    description={Un linguaggio di programmazione o specifica dedicato a un particolare dominio di problemi, a differenza dei linguaggi general-purpose. Offre una sintassi espressiva ottimizzata per quel contesto specifico}
}

\newglossaryentry{apk}{
    name={APK (Android Package Kit)},
    description={Il formato di file pacchetto utilizzato dal sistema operativo Android per la distribuzione e l'installazione di applicazioni mobili e middleware}
}

\newglossaryentry{gdpr}{
    name={GDPR (General Data Protection Regulation)},
    description={Regolamento dell'Unione Europea in materia di trattamento dei dati personali e di privacy, che impone obblighi stringenti alle organizzazioni riguardo la raccolta, l'archiviazione e la protezione dei dati degli utenti}
}

% =======================================
% MODELLAZIONE E TERMINI GENERALI
% =======================================

\newglossaryentry{erd}{
    name={ERD (Entity-Relationship Diagram)},
    description={Modello grafico utilizzato per descrivere la struttura logica di un database, rappresentando le entità coinvolte nel dominio informativo e le relazioni che intercorrono tra di esse}
}

\newglossaryentry{uml}{
    name={UML (Unified Modeling Language)},
    description={Linguaggio standardizzato di modellazione visuale utilizzato nel campo dell'ingegneria del software per specificare, visualizzare, costruire e documentare gli artefatti di un sistema software orientato agli oggetti}
}

\newglossaryentry{furps}{
    name={FURPS+},
    description={Modello per la classificazione dei requisiti di qualità del software. L'acronimo sta per Functionality, Usability, Reliability, Performance, Supportability; il ``+'' indica vincoli aggiuntivi come design, implementazione e interfacce}
}

\newglossaryentry{e2e}{
    name={End-to-end},
    description={Termine che descrive un processo o una soluzione che copre l'intero flusso operativo, dall'inizio alla fine, senza discontinuità o dipendenze esterne non gestite}
}

\newglossaryentry{verticalsolution}{
    name={Soluzione Verticale},
    description={Software progettato specificamente per un determinato settore di mercato o industria, rispondendo a esigenze di nicchia, in contrapposizione alle soluzioni "orizzontali" generaliste}
}

\newglossaryentry{associativeclass}{
    name={Classe Associativa},
    description={Elemento dei diagrammi UML che permette di associare proprietà e attributi a una relazione tra due classi, trattando la relazione stessa come un'entità (classe)}
}

% =======================================
% LINGUAGGI, FRAMEWORK E STRUMENTI
% =======================================

\newglossaryentry{dart}{
    name={Dart},
    description={Linguaggio di programmazione open-source, orientato agli oggetti e fortemente tipizzato, ottimizzato per lo sviluppo di interfacce utente veloci su diverse piattaforme}
}

\newglossaryentry{plpgsql}{
    name={PL/pgSQL},
    description={Linguaggio procedurale strutturato supportato dal DBMS PostgreSQL, utilizzato per creare funzioni complesse, trigger e stored procedure, estendendo le capacità del classico SQL}
}

\newglossaryentry{typescript}{
    name={TypeScript},
    description={Super-set sintattico rigoroso di JavaScript che aggiunge la tipizzazione statica opzionale al linguaggio, migliorando la scalabilità e la rilevazione degli errori durante lo sviluppo}
}

\newglossaryentry{deno}{
    name={Deno},
    description={Runtime sicuro per JavaScript e TypeScript che utilizza V8 ed è scritto in Rust. Progettato per essere moderno e performante, supporta nativamente TypeScript senza configurazioni complesse}
}

\newglossaryentry{flutter}{
    name={Flutter},
    description={Framework open-source per lo sviluppo di interfacce utente (UI toolkit), che permette di creare applicazioni compilate nativamente per mobile, web e desktop a partire da un'unica codebase}
}

\newglossaryentry{supabase}{
    name={Supabase},
    description={Piattaforma Backend-as-a-Service open-source basata su PostgreSQL, che offre un set integrato di strumenti backend (database real-time, autenticazione, storage) alternativo a soluzioni proprietarie}
}

\newglossaryentry{firebase}{
    name={Firebase},
    description={Piattaforma di sviluppo applicativo supportata da Google che offre servizi backend gestiti, nota in particolare per i suoi database NoSQL real-time e servizi di analytics}
}

\newglossaryentry{postgresql}{
    name={PostgreSQL},
    description={Sistema di gestione di database relazionale a oggetti (ORDBMS) open-source, rinomato per la sua affidabilità, robustezza delle funzionalità e conformità agli standard tecnici}
}

\newglossaryentry{git}{
    name={Git},
    description={Sistema di controllo di versione distribuito (DVCS) utilizzato per tracciare le modifiche nel codice sorgente durante lo sviluppo software, facilitando la collaborazione tra programmatori}
}

\newglossaryentry{vercel}{
    name={Vercel},
    description={Piattaforma cloud per il deployment di frontend statici e funzioni serverless, focalizzata sull'esperienza dello sviluppatore e sulle prestazioni delle applicazioni web}
}

\newglossaryentry{resend}{
    name={Resend},
    description={Servizio e API dedicato all'invio di email transazionali e di marketing, progettato per integrarsi facilmente nei moderni stack di sviluppo software}
}

\newglossaryentry{retool}{
    name={Retool},
    description={Piattaforma di sviluppo low-code orientata alla costruzione rapida di strumenti interni, dashboard e pannelli di amministrazione che si connettono a database e API esistenti}
}

\newglossaryentry{jetpackcompose}{
    name={Jetpack Compose},
    description={Toolkit moderno e dichiarativo di Google per la creazione di interfacce utente native Android, che semplifica lo sviluppo UI riducendo la quantità di codice necessario}
}

\newglossaryentry{kmp}{
    name={Kotlin Multiplatform (KMP)},
    description={Tecnologia che permette la condivisione del codice Kotlin tra diverse piattaforme (iOS, Android, Web, Desktop), pur mantenendo la possibilità di scrivere codice specifico per piattaforma quando necessario}
}

\newglossaryentry{composemultiplatform}{
    name={Jetpack Compose Multiplatform},
    description={Framework UI dichiarativo basato su Kotlin e Jetpack Compose che estende lo sviluppo dell'interfaccia utente oltre Android, supportando desktop (Windows, MacOS, Linux), web e iOS}
}